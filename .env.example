# Every environment variable read by the contextlift code, its tests, or the
# Makefile, with a safe placeholder. contextlift does not load this file itself.
# Copy it to .env, fill it in, and source it in the shell that runs the
# commands:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# .env is gitignored. None of these is required for the SQLite path.

# --- read by src/context_lift ---

# Record every command under this directory (same as --workspace DIR).
CONTEXTLIFT_WORKSPACE=./work

# The Google Cloud project that pays for Gemini calls (generate, judge,
# draft-rules, review --draft, chat). Same as --project.
CONTEXTLIFT_PROJECT=my-project

# Alternative to Vertex credentials: when set, Gemini calls use the Google AI
# Studio Developer API. Keep the key in an untracked .env or a secret manager,
# never on a command line (workspace manifests record argv).
GEMINI_API_KEY=

# Comma-separated project-id prefixes that must never be billed. Any
# command about to run a BigQuery job or a model call against a project
# that starts with one of these stops before spending. Leave empty to
# forbid nothing.
CONTEXTLIFT_FORBIDDEN_PROJECTS=acme-prod,acme-

# The model behind chat and the drafting steps: unset for Gemini,
# "echo" to answer with CONTEXTLIFT_DRAFT_ECHO instead (tests, demos).
CONTEXTLIFT_DRAFT_BACKEND=
CONTEXTLIFT_DRAFT_ECHO=

# The editor chat opens for the Edit action; VISUAL wins over EDITOR, and
# without either it runs vi.
VISUAL=
EDITOR=vi

# Read by the google-genai SDK, not by contextlift, when no --project and no
# CONTEXTLIFT_PROJECT is given. Checked against CONTEXTLIFT_FORBIDDEN_PROJECTS too.
GOOGLE_CLOUD_PROJECT=my-project

# --- read by the tests and the Makefile, never by src/context_lift ---

# The live catalog tests (make test-integration) need a catalogued table
# in a Knowledge Catalog. Free; the fast suite never reads these.
CONTEXTLIFT_CATALOG_PROJECT=my-project
CONTEXTLIFT_CATALOG_LOCATION=us-central1
CONTEXTLIFT_CATALOG_TABLE=sales.orders
# The write half of those tests: set to 1 to run it, against a sandbox
# table whose overview may be overwritten.
CONTEXTLIFT_CATALOG_WRITE=
CONTEXTLIFT_CATALOG_WRITE_TABLE=sandbox.scratch_orders

# --- named in messages, never read ---

# Where gcloud keeps its credentials, when not the default ~/.config/gcloud.
# Read by the Google client libraries; contextlift only names it in the error
# it prints when no credentials are found.
CLOUDSDK_CONFIG=$HOME/.config/gcloud

# contextlift passes PYTHONPATH through to the commands chat runs for you; it
# never sets it. Set it yourself only to run a second checkout's code.
